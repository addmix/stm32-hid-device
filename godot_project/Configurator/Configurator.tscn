[sub_resource type="GDScript" id="GDScript_4v018"]
script/source = "extends ConfirmationDialog

signal file_list_changed

var config : Config
var filepath : String = \"\"


func _on_confirmed() -> void:
	var error : Error = ResourceSaver.save(config, filepath)
	file_list_changed.emit()
	if not error == OK:
		print(\"Error when saving preset: %s\" % error)
	
	config = null
	filepath = \"\"

func _on_canceled() -> void:
	config = null
	filepath = \"\"
"

[sub_resource type="GDScript" id="GDScript_oo0gl"]
script/source = "extends Button


func _on_pressed() -> void:
	$\"../SerialMonitor\".visible = true
"

