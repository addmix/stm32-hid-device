[sub_resource type="GDScript" id="GDScript_i1jgh"]
script/source = "extends MarginContainer

const user_path = \"user://\"
const save_path = \"presets/\"

const absolute_save_path = user_path + save_path

func _ready() -> void:
	load_selector_items()

func build_config_from_editor() -> Config:
	var config := Config.new()
	
	for pin_button : PinButton in NodeUtils.get_descendants_of_type(self, PinButton):
		config.add_pin(pin_button.pin)
		config.add_input_mappings(pin_button.input_mappings)
	
	return config

func fill_editor_from_config(config : Config) -> void:
	
	for pin_button : PinButton in NodeUtils.get_descendants_of_type(self, PinButton):
		var pin_name : int = pin_button.pin.pin_name
		
		#find all input mappings for the current pin
		var matching_inputs : Array[InputMapping] = []
		for mapping : InputMapping in config.pin_bindings:
			if not mapping.pin_name == pin_name:
				continue
			
			matching_inputs.append(mapping)
		
		pin_button.input_mappings = matching_inputs
		
		
		#update pin properties (never change pin_name)
		if config.pin_map.has(pin_name):
			var pin_declaration : PinDeclaration = config.pin_map.get(pin_name, null)
			if not pin_declaration:
				continue
			
			pin_button.pin.analog = pin_declaration.analog
			pin_button.pin.inactive_value = pin_declaration.inactive_value
	
	

func clear() -> void:
	#Should this also clear analog or inactive_value?
	for pin_button : PinButton in NodeUtils.get_descendants_of_type(self, PinButton):
		pin_button.input_mappings = []

func _on_apply_button_pressed() -> void:
	var config := build_config_from_editor()
	
	
	#TODO - convert the main serial logic from the main scene into a singleton, and then run this command on the singleton
	Serial.write(SerialCommandBuilder.create_command(Enums.Commands.SetConfigs, config.get_data()))

func _on_clear_confirmation_dialog_confirmed() -> void:
	clear()

func _on_save_button_pressed() -> void:
	var config := build_config_from_editor()
	
	#double check that the save path actually exists
	if not DirAccess.dir_exists_absolute(absolute_save_path):
		print(\"created save folder\")
		DirAccess.make_dir_recursive_absolute(absolute_save_path)
	
	var dir := DirAccess.open(absolute_save_path)
	
	var preset_filename : String = $HBoxContainer/CenterContainer2/VBoxContainer/PresetName.text
	var preset_filepath : String = absolute_save_path + preset_filename + \".tres\"
	
	$HBoxContainer/CenterContainer2/VBoxContainer/PresetName/OverwriteConfirmationDialog.config = config
	$HBoxContainer/CenterContainer2/VBoxContainer/PresetName/OverwriteConfirmationDialog.filepath = preset_filepath
	if dir.file_exists(preset_filepath):
		$HBoxContainer/CenterContainer2/VBoxContainer/PresetName/OverwriteConfirmationDialog.popup_centered()
	
	$HBoxContainer/CenterContainer2/VBoxContainer/PresetName/OverwriteConfirmationDialog.confirmed.emit()
	#$HBoxContainer/CenterContainer2/VBoxContainer/PresetName.text = \"\"

func _on_delete_confirmation_dialog_confirmed() -> void:
	var item_text : String = $HBoxContainer/CenterContainer2/VBoxContainer/PresetSelector.get_item_text($HBoxContainer/CenterContainer2/VBoxContainer/PresetSelector.selected)
	if item_text == \"\":
		return
	
	var dir := DirAccess.open(absolute_save_path)
	dir.remove(item_text + \".tres\")
	
	load_selector_items()
	$HBoxContainer/CenterContainer2/VBoxContainer/PresetName.text = \"\"


func load_selector_items() -> void:
	var dir := DirAccess.open(absolute_save_path)
	
	$HBoxContainer/CenterContainer2/VBoxContainer/PresetSelector.clear()
	
	$HBoxContainer/CenterContainer2/VBoxContainer/PresetSelector.add_item(\"\")
	var id : int = 0
	for file_name : String in dir.get_files():
		id += 1
		if not file_name.ends_with(\".tres\"):
			print(\"Only text resource files (*.tres) are supported.\")
			continue
		
		file_name = file_name.trim_suffix(\".tres\")
		
		$HBoxContainer/CenterContainer2/VBoxContainer/PresetSelector.add_item(file_name)
		
		if file_name == $HBoxContainer/CenterContainer2/VBoxContainer/PresetName.text:
			$HBoxContainer/CenterContainer2/VBoxContainer/PresetSelector.selected = id

func _on_preset_selector_item_selected(index: int) -> void:
	var item_text : String = $HBoxContainer/CenterContainer2/VBoxContainer/PresetSelector.get_item_text(index)
	$HBoxContainer/CenterContainer2/VBoxContainer/PresetName.text = item_text
	
	if item_text == \"\":
		return
	
	var dir := DirAccess.open(absolute_save_path)
	
	var config : Config = load(absolute_save_path + item_text + \".tres\")
	fill_editor_from_config(config)


func _on_overwrite_confirmation_dialog_file_list_changed() -> void:
	load_selector_items()
"

