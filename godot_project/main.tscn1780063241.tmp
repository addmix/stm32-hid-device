func _on_pressed() -> void:
	%SerialOutput.text = \"\"
"

[sub_resource type="GDScript" id="GDScript_h2yge"]
script/source = "extends HBoxContainer

#TODO: expand this to accept human-readable pin names
func get_value() -> int:
	var text : String = $Index.text
	
	var index : int = 0
	if text in [\"\", \"-1\"]:
		index = 255
	else:
		index = int(text)
	
	return index

func _on_list_configs_button_pressed() -> void:
	$\"../../../../..\".write(SerialCommandBuilder.create_command(Enums.Commands.ListConfigs))

func _on_list_pins_button_pressed() -> void:
	$\"../../../../..\".write(SerialCommandBuilder.create_command(Enums.Commands.ListPins, [get_value()]))

func _on_list_mappings_button_pressed() -> void:
	$\"../../../../..\".write(SerialCommandBuilder.create_command(Enums.Commands.ListMappings, [get_value()]))

func _on_list_augments_button_pressed() -> void:
	$\"../../../../..\".write(SerialCommandBuilder.create_command(Enums.Commands.ListAugments, [get_value()]))
"

